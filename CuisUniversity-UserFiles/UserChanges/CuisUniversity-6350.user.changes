Object subclass: #Zombie
	instanceVariableNames: 'energia'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Ejercicio2'!
!Zombie methodsFor: 'nil' stamp: 'TM 3/21/2025 12:08:12'!
energia
	^energia. ! !
!Zombie methodsFor: 'nil' stamp: 'TM 3/21/2025 12:08:49' overrides: 16932297!
initialize
	energia := 28.
	^self. ! !
!Zombie methodsFor: 'nil' stamp: 'TM 3/21/2025 12:10:32'!
caminar: cantKm
	energia  := energia  - (3 + cantKm ).
	^self.! !
!Zombie methodsFor: 'nil' stamp: 'TM 3/21/2025 12:11:24'!
comer: cantKilos

	energia  := energia  + (4*cantKilos ).
	^self.! !

