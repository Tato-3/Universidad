!Penales methodsFor: 'initialize' stamp: 'TM 4/29/2025 12:47:31'!
arbitroPitaConPelota: unaPelota delanteroRemataAlArcoConDireccion: direccPelota arqueroSeLanzaEnDirección: direccArquero

	pelota := unaPelota.
	direccRemateResultante := direccPelota.
	direccAtajadaResultante := direccArquero.
	
	 self validarDireccion: direccRemateResultante conError: [self error: Penales direccionTiroFueraDeRango ].
	
	 self validarDireccion: direccAtajadaResultante conError: [self error: Penales direccionArqueroFueraDeRango ].
	
	delantero tiroElegido evaluarTiroDel: delantero al: arquero con: pelota enLos: self.! !

!Penales methodsFor: 'initialize' stamp: 'TM 4/27/2025 12:23:42'!
initializeConDelantero: unDelantero yArquero: unArquero 
	
	
	
	delantero := unDelantero. 
	arquero := unArquero.
		
	fuerzaDelTiro := delantero fuerza.
