!AColocar methodsFor: 'action' stamp: 'TM 4/29/2025 12:47:49'!
evaluarTiroDel: delantero al: arquero con: pelota enLos: penales 

	| esMismaDireccion fuerzaDeLaAtajada fuerzaDelTiro |
	
	delantero ajustarFuerzaAColocar.
	
	pelota isJabulani ifTrue: [ | direccAtajadaResultante direccRemateResultante |
            esMismaDireccion := direccRemateResultante x = direccAtajadaResultante x.
		(arquero atajadaElegida class = Decidido ) ifTrue: [arquero fuerza: (arquero fuerza * 1.5)			].
		(arquero atajadaElegida class = Adelantada ).
		fuerzaDelTiro := delantero fuerza .
		fuerzaDeLaAtajada := arquero fuerza.
        ].
        
        pelota isPlayera ifTrue: [
            delantero fuerza: (delantero fuerza * 0.8).
            (arquero atajadaElegida class = Decidido ) ifTrue: [arquero fuerza: (arquero fuerza * 2)			].
	     (arquero atajadaElegida class = Adelantada ) ifTrue: [^self puntuaElDelantero ].
            fuerzaDelTiro := delantero fuerza.
            fuerzaDeLaAtajada := arquero fuerza.
        ].
        
        esMismaDireccion ifTrue: [
            (self quienEsMasFuerte: delantero oEl: arquero) puntuaEnLos: self
        ] ifFalse: [
            self puntuaElDelantero
        ].	! !


