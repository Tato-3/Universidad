            (direccPelota x = direccArquero x)
            ifTrue: [(self quienEsMasFuerte: delantero oEl: arquero) puntuaEnLos: self]
            ifFalse: [self puntuaElDelantero]
       ]. 
		pelota isPlayera ifTrue: [delantero fuerza: (delantero fuerza - (delantero fuerza * 20 / 100)). fuerzaDelTiro := delantero fuerza. arquero fuerza: (arquero fuerza + (arquero fuerza / 2)). fuerzaDeLaAtajada := arquero fuerza.
			(direccPelota = direccArquero)
            ifTrue: [(self quienEsMasFuerte: delantero oEl: arquero) puntuaEnLos: self]
            ifFalse: [self puntuaElDelantero]
    ].

	

	! !

