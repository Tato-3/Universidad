!AMatar methodsFor: 'action' stamp: 'TM 4/29/2025 12:47:16'!
evaluarTiroDel: delantero al: arquero con: pelota enLos: penales  

| direccAtajadaResultante direccRemateResultante esMismaDireccion fuerzaDeLaAtajada fuerzaDelTiro |
	
	pelota isJabulani ifTrue: [
		delantero fuerza: (delantero fuerza * 1.2).
		(direccRemateResultante x even and: (direccRemateResultante y even)) ifTrue: [
		direccRemateResultante := direccRemateResultante x @ 1].
              esMismaDireccion := direccRemateResultante x = direccAtajadaResultante x.
		fuerzaDelTiro := delantero fuerza.
		fuerzaDeLaAtajada := arquero fuerza.
		(arquero atajadaElegida class = Adelantada ) ifTrue: [^self puntuaElDelantero ].
        ].
        
        pelota isPlayera ifTrue: [
	(direccRemateResultante x odd or: (direccRemateResultante y odd)) ifTrue: [direccRemateResultante := direccRemateResultante x @ (direccRemateResultante y + 2)]
		ifFalse: [	direccRemateResultante := direccRemateResultante x @ 1].
		esMismaDireccion := direccRemateResultante = direccAtajadaResultante .
		[direccRemateResultante between: 0@0 and: 2@2] value ifFalse: [^self puntuaElArquero ].
		(arquero atajadaElegida class = Decidido ) ifTrue: [arquero fuerza: (arquero fuerza * 2)			. esMismaDireccion := direccRemateResultante y = direccAtajadaResultante y].
		(arquero atajadaElegida class = Adelantada ) ifTrue: [^self puntuaElArquero].
            fuerzaDelTiro := delantero fuerza.
            fuerzaDeLaAtajada := arquero fuerza.
        ].
        
        esMismaDireccion ifTrue: [
            (self quienEsMasFuerte: delantero oEl: arquero) puntuaEnLos: self
        ] ifFalse: [
            self puntuaElDelantero
        ].
	
	fuerzaDelTiro := delantero fuerza .
	fuerzaDeLaAtajada := arquero fuerza .! !


