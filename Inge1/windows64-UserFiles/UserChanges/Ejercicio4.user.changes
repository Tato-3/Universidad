	classVariableNames: ''
	poolDictionaries: ''
	category: 'Ejercicio4'!

!classDefinition: #IIIII category: #Ejercicio4 stamp: 'TM 3/28/2025 11:21:40'!
DenotativeObject subclass: #IIIII
	instanceVariableNames: ''
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Ejercicio4'!

IIIII class
	instanceVariableNames: 'next previous'!

!classDefinition: 'IIIII class' category: #Ejercicio4 stamp: 'TM 3/28/2025 11:21:40'!
IIIII class
	instanceVariableNames: 'next previous'!
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:40'!
* aNum

	aNum = I ifTrue: [^self].
	^ self + aNum * aNum previous.! !
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:40'!
+ num

	^ self previous  + num next.! !
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:40'!
- aNum

	self <= aNum ifTrue: [^nil].
	aNum = I ifTrue: [^ self previous.].
	^ self previous - aNum previous.! !
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:40'!
/ aNum

    aNum <= self ifFalse: [^ nil].
    aNum = I ifTrue: [^ self]. 
    self = aNum ifTrue: [^ I].
	aNum <= (self - aNum) ifFalse: [^I]. 
    ^ ((self - aNum) / aNum) + I.
! !
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:40'!
<= aNum
	
	aNum = I ifTrue:[^false ].
	^ self previous <= aNum previous.! !
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:40'!
nameOfNext

	^self name, 'I'.! !
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:40'!
next
	
	|nombre|
	nombre := self nameOfNext.
	
	next := Smalltalk at: nombre asSymbol ifAbsent: [II  cloneNamed: nombre.].
	next previous: self. 
	
	^next.! !
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:41'!
previous
	^previous .! !
!IIIII class methodsFor: '-- all --' stamp: 'TM 3/28/2025 11:21:41'!
previous: aNumber

	previous := aNumber ! !

