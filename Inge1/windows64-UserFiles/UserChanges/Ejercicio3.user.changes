IIII / III!

IIII / II!

IIII / II!
!II class methodsFor: '-- all --' stamp: 'TM 3/23/2025 17:23:12' prior: 50540717!
/ aNum
    | res |
    self < aNum ifTrue: [^ nil]. "Caso base: si self es menor que aNum, no se puede dividir"
    
    aNum = I ifTrue: [^ self]. "Caso base: dividir por I devuelve self"
    
    res := I. "Inicializamos el cociente con I"
    
    (res * aNum = self) ifTrue: [^ res]. "Si el producto es exacto, retornamos el cociente"

    ^ (self - aNum) / aNum + I. "Resta aNum de self y llama recursivamente sumando I"
! !

